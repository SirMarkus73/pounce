{
  "name": "@pounce-dl/core",
  "version": "0.1.0",
  "description": "Core de pounce: cliente de aria2 para gestionar descargas",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./connection": {
      "source": "./src/public/connection.ts",
      "types": "./dist/src/public/connection.d.ts",
      "default": "./dist/src/public/connection.js"
    },
    "./constants": {
      "source": "./src/constants/index.ts",
      "types": "./dist/src/constants/index.d.ts",
      "default": "./dist/src/constants/index.js"
    },
    "./types": {
      "source": "./src/types/index.ts",
      "types": "./dist/src/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun build ./index.ts ./src/public/connection.ts ./src/constants/index.ts --outdir dist --root . --target node --splitting && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "maria2": "^0.4.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
